---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const canonicalUrl = 'https://zenof519-ops.github.io/zeno-video/contact/';
const pageTitle = 'Contact — Zeno Video';
const pageDescription = 'Retrouve les moyens officiels de contacter Zeno Video et ses réseaux sociaux.';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zeno Video" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href={`${base}style.css?v=17`} />
  </head>
  <body>
    <header><a class="brand" href={base}><b>Z</b> ZENO VIDEO</a><a href={base}>← Bibliothèque</a></header>
    <main>
      <p class="eyebrow">RESTONS EN CONTACT</p>
      <h1>Parlons de <em>Zeno Video.</em></h1>
      <p class="intro">Une question, une suggestion ou envie de suivre nos nouveautés ? Retrouve ici tous nos espaces officiels et contacte-nous sur la plateforme qui te convient.</p>
      <section class="contact-panel" aria-labelledby="social-heading">
        <h2 id="social-heading">Retrouve-nous sur nos réseaux</h2>
        <p>Abonne-toi pour suivre les actualités de Zeno Video, discuter avec la communauté ou nous envoyer un message.</p>
        <div class="contact-social-grid">
          <a class="contact-social-link tiktok" href="https://www.tiktok.com/@zeno.force87?_r=1&amp;_t=ZN-9BmD2BVAfwc" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le profil TikTok de Zeno">
            <span class="contact-social-icon" aria-hidden="true">♪</span><span class="contact-social-copy"><strong>TikTok</strong><small>Nos vidéos et nouveautés</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-social-link x-social" href="https://x.com/ZenoForc7" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le profil X de Zeno">
            <span class="contact-social-icon" aria-hidden="true">𝕏</span><span class="contact-social-copy"><strong>X (Twitter)</strong><small>Actualités et annonces</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-social-link instagram" href="https://www.instagram.com/zeno.force?fqnt=ZnA2MzJwb2FkbmY5" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le profil Instagram de Zeno">
            <span class="contact-social-icon" aria-hidden="true">◎</span><span class="contact-social-copy"><strong>Instagram</strong><small>Photos et publications</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-social-link facebook" href="https://www.facebook.com/profile.php?id=61596919143045" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir la page Facebook de Zeno">
            <span class="contact-social-icon" aria-hidden="true">f</span><span class="contact-social-copy"><strong>Facebook</strong><small>Retrouve notre page</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-social-link whatsapp" href="https://wa.me/22947835320" target="_blank" rel="noopener noreferrer" aria-label="Envoyer un message WhatsApp à Zeno">
            <span class="contact-social-icon" aria-hidden="true">☏</span><span class="contact-social-copy"><strong>WhatsApp</strong><small>Écris-nous directement</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-social-link discord" href="https://discord.gg/MRXcGsd4" target="_blank" rel="noopener noreferrer" aria-label="Rejoindre le serveur Discord de Zeno">
            <span class="contact-social-icon" aria-hidden="true">◉</span><span class="contact-social-copy"><strong>Discord</strong><small>Rejoins la communauté</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-social-link reddit" href="https://www.reddit.com/u/AquilasUrbain/s/JoGs9SuRqg" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le profil Reddit de Zeno">
            <span class="contact-social-icon" aria-hidden="true">●</span><span class="contact-social-copy"><strong>Reddit</strong><small>Retrouve-nous sur Reddit</small></span><span class="contact-social-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="contact-links"><a class="btn alt" href={base}>← Retour à la bibliothèque</a></div>
      </section>
    </main>
    <footer>ZENO VIDEO · Un lecteur, tes vidéos, tes liens.</footer>
  </body>
</html>

<style>
  .contact-social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 245px), 1fr));
    gap: 12px;
    margin-top: 22px;
  }
  .contact-social-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 14px;
    border: 1px solid rgba(184, 116, 230, .38);
    border-radius: 13px;
    background: rgba(10, 10, 22, .38);
    transition: transform .18s ease, border-color .18s ease, background .18s ease;
  }
  .contact-social-link:hover {
    transform: translateY(-2px);
    border-color: rgba(85, 217, 242, .75);
    background: rgba(85, 217, 242, .08);
  }
  .contact-social-icon {
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(85, 217, 242, .22), rgba(237, 75, 183, .24));
    color: #fff;
    font-size: 23px;
    font-weight: 800;
  }
  .contact-social-copy { display: grid; gap: 4px; min-width: 0; }
  .contact-social-copy strong { color: #fff5ff; font-size: 15px; }
  .contact-social-copy small { color: var(--zeno-muted); font-size: 11px; line-height: 1.35; }
  .contact-social-arrow { margin-left: auto; color: var(--zeno-gold); font-size: 17px; }
  .contact-social-link.whatsapp .contact-social-icon { background: rgba(37, 211, 102, .2); color: #7cf0a6; }
  .contact-social-link.discord .contact-social-icon { background: rgba(88, 101, 242, .22); color: #aeb6ff; }
  .contact-social-link.instagram .contact-social-icon { background: rgba(225, 48, 108, .2); color: #ff9cbe; }
  @media (prefers-reduced-motion: reduce) {
    .contact-social-link { transition: none; }
  }
</style>
