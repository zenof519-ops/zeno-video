---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Retrouve les vidéos disponibles sur Zeno Video et partage leur lecteur en un seul lien." />
    <title>Zeno Video</title>
    <link rel="stylesheet" href={`${base}style.css?v=10`} />
  </head>
  <body>
    <header>
      <a class="brand" href={base}><b>Z</b> ZENO VIDEO</a>
      <span>BIBLIOTHÈQUE</span>
    </header>
    <main>
      <p class="eyebrow">LA GALERIE VIDÉO</p>
      <h1>Bienvenue dans<br /><em>ma vidéothèque.</em></h1>
      <p class="intro">Retrouve ici les vidéos disponibles et partage leur lecteur en un seul lien.</p>
      <section>
        <div class="section-title"><h2>Mes vidéos</h2><span id="video-count"></span></div>
        <div id="video-grid" class="grid"></div>
        <p id="empty-message" hidden>Aucune vidéo pour le moment.</p>
      </section>
    </main>
    <footer>ZENO VIDEO · Un lecteur, tes vidéos, tes liens.</footer>
    <script is:inline src={`${base}videos.js`} defer></script>
    <script is:inline src={`${base}library.js?v=10`} defer></script>
  </body>
</html>
